---
import { Mail, MapPin, Phone } from "@lucide/astro";
import Logo from "./Logo.astro";
import { NAV, SITIO, telHref } from "../site";
---

<footer class="bg-primary-dark text-white/75">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[2fr_1fr_1.5fr]">
    <div class="flex flex-col gap-4">
      <Logo invertido />
      <p class="max-w-sm text-sm leading-relaxed">
        Renta y construcción de bodegas industriales en Mérida, Yucatán. Espacios a la medida de tu
        operación.
      </p>
    </div>
    <div>
      <h2 class="mb-4 text-sm font-semibold tracking-wide text-white">Navegación</h2>
      <ul class="flex flex-col gap-2 text-sm">
        {NAV.map((item) => <li><a class="hover:text-white" href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="mb-4 text-sm font-semibold tracking-wide text-white">Contacto</h2>
      <ul class="flex flex-col gap-3 text-sm">
        <li>
          <a class="flex items-center gap-2 hover:text-white" href={telHref()}>
            <Phone class="size-4" aria-hidden="true" />{SITIO.telefono}
          </a>
        </li>
        <li>
          <a class="flex items-center gap-2 hover:text-white" href={`mailto:${SITIO.correo}`}>
            <Mail class="size-4" aria-hidden="true" />{SITIO.correo}
          </a>
        </li>
        <li class="flex items-center gap-2">
          <MapPin class="size-4 shrink-0" aria-hidden="true" />{SITIO.direccion}
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-page py-5 text-xs text-white/50">
      © {new Date().getFullYear()} Bodegas de Yucatán. Todos los derechos reservados.
    </p>
  </div>
</footer>
