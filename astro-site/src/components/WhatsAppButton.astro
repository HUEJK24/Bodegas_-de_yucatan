---
import { MessageCircle } from "@lucide/astro";
import { whatsappHref } from "../site";

interface Props {
  titulo?: string;
  mensaje?: string;
  flotante?: boolean;
  etiqueta?: string;
  class?: string;
}

const { titulo, mensaje, flotante = false, etiqueta = "Cotizar por WhatsApp", class: clase } = Astro.props;
const texto =
  mensaje ??
  (titulo
    ? `Hola, estoy interesado en rentar la ${titulo}.`
    : "Hola, quiero información sobre las bodegas disponibles.");
const href = whatsappHref(texto);
---

{
  flotante ? (
    <a
      href={href}
      target="_blank"
      rel="noopener"
      class="fixed right-5 bottom-5 z-50 flex size-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg shadow-black/20 transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25d366]"
    >
      <MessageCircle class="size-7" aria-hidden="true" />
      <span class="sr-only">Contactar por WhatsApp</span>
    </a>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="noopener"
      class:list={["btn bg-[#1e9e4f] text-white hover:bg-[#178541]", clase]}
    >
      <MessageCircle class="size-5" aria-hidden="true" />
      {etiqueta}
    </a>
  )
}
