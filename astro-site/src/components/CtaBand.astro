---
import { Phone } from "@lucide/astro";
import WhatsAppButton from "./WhatsAppButton.astro";
import { SITIO, telHref } from "../site";
---

<section class="py-16 md:py-20">
  <div class="container-page">
    <div
      class="flex flex-col items-start justify-between gap-8 rounded-xl bg-primary p-8 md:flex-row md:items-center md:p-12"
    >
      <div class="flex max-w-xl flex-col gap-3">
        <h2 class="text-3xl font-bold text-white">¿Listo para encontrar tu espacio?</h2>
        <p class="text-white/80">
          Escríbenos por WhatsApp o llámanos y recibe una cotización personalizada hoy mismo.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <WhatsAppButton etiqueta="Hablar con un asesor" />
        <a href={telHref()} class="btn bg-white text-primary hover:bg-primary-soft">
          <Phone class="size-4" aria-hidden="true" />{SITIO.telefonoCorto}
        </a>
      </div>
    </div>
  </div>
</section>
